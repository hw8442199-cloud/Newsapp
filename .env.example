# Copy this file to .env and fill in real values. Never commit the
# actual .env file -- add it to .gitignore. If deploying on Replit, use
# Replit Secrets instead of a committed .env.

NVIDIA_API_KEY=nvapi-your-key-here

# Your site's public URL once deployed. Required for the RSS feed's
# item links to be usable by subscribers -- without it they'll point at
# localhost.
SITE_URL=https://your-domain.example.com

# Optional: override where the SQLite DB file lives (defaults to
# news.db next to db.py).
# NEWS_DB_PATH=/data/news.db
